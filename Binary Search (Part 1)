# 5️⃣ Iterative Binary Search

### C++ Code

```cpp
#include<iostream>
using namespace std;

int binarySearch(int arr[], int n, int target)
{
    int low = 0;
    int high = n - 1;

    while(low <= high)
    {
        int mid = low + (high - low) / 2;

        if(arr[mid] == target)
            return mid;

        else if(arr[mid] < target)
            low = mid + 1;

        else
            high = mid - 1;
    }

    return -1;
}

int main()
{
    int arr[] = {2,5,8,12,16,23,38,45};
    int n = 8;

    int target = 23;

    int index = binarySearch(arr, n, target);

    if(index != -1)
        cout<<"Element Found at Index "<<index;
    else
        cout<<"Element Not Found";
}
```

